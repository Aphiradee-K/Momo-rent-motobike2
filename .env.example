# Server port
PORT=3000

# Secret used to sign login tokens (JWT) — change this in production
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection string (recommended / required on Vercel)
# Get this from Neon or Supabase. Use the POOLED connection string.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional: max connections per serverless instance
PGPOOL_MAX=5

# Used only when DATABASE_URL is NOT set (local development fallback)
DB_FILE=data/momo.db
